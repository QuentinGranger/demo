  "filter_modes": {
    "STRICT": {
      "include_basis": ["DIRECT"],
      "relation_depth": 0,
      "use_case": "Je veux uniquement ce qui est explicitement consacré à cette entité."
    },
    "EXPANDED": {
      "include_basis": ["DIRECT", "INHERITED", "DERIVED", "UMBRELLA"],
      "relation_depth_max": 2,
      "allowed_relations": ["PART_OF", "HAS_HOUSE", "HAS_ERA", "BELONGS_TO_SUBFRANCHISE", "THEMATIC_EQUIVALENT"],
      "use_case": "Je veux aussi les relations vérifiées, sans associations lointaines."
    },
    "CANON_ONLY": {
      "allowed_canon_scope": ["CORE_STORY", "SCREEN_ADAPTATION", "GAME_UNIVERSE", "STAGE_ADAPTATION"],
      "exclude_scope": ["LICENSED_MERCH", "LICENSED_EXPERIENCE", "LICENSED_PARODY", "FRANCHISE_META"]
    },
    "COLLECTOR": {
      "combine_with_event_fields": ["X-HARRYPOTTER-COLLECTOR-INTEREST", "X-HARRYPOTTER-LIMITED"],
      "preferred_themes": ["COLLECTING", "FILM_PROPS", "ILLUSTRATION", "HOUSE_MERCH"],
      "rule": "Un tag sémantique ne remplace jamais la preuve collector/limited du VEVENT."
    }
