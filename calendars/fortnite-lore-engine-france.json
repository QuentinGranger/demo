  "base_registry": "fortnite-taxonomy-france.json",
  "lore_registry": "fortnite-lore-taxonomy-france.json",
  "scope": "Lore entity resolution, safe traversal, query expansion and calendar materialization policy",
  "filter_modes": {
    "STRICT": "Only entities directly assigned to the event or explicitly stated by an authorized source.",
    "EXPANDED": "DIRECT + verified forward materialization relations, maximum depth 2.",
    "CANON_ONLY": "Exclude COSMETIC_ONLY, GAMEPLAY_ONLY, META and UNKNOWN unless the query explicitly requests them.",
    "CHAPTER_VIEW": "Query-only reverse/forward traversal around a chapter; useful for filters such as Chapitre 2.",
    "ENTITY_VIEW": "Query-only neighborhood around a character, organization, POI or object; useful for Jones/Midas/Zero Point.",
    "TIMELINE_VIEW": "Query-only historical sequence using PRECEDES/SUCCESSOR_OF and event participation.",
    "HISTORICAL": "Historical events plus directly linked chapter, participants, organizations, POIs and lore objects."
  },
  "materialization": {
    "max_depth": 2,
    "allowed_forward_relations": ["MEMBER_OF", "PART_OF_ISLAND", "BELONGS_TO_CHAPTER", "OCCURS_IN_CHAPTER", "OCCURS_IN_REALITY", "OCCURS_IN_TIMELINE"],
    "query_only_relations": ["INVOLVES", "CENTERS_ON", "OPPOSES", "PRECEDES", "SUCCESSOR_OF", "LOCATED_AT"],
    "basis": ["DIRECT", "INHERITED", "VERIFIED_DERIVED", "QUERY_EXPANDED"],
    "rule": "QUERY_EXPANDED never becomes an ICS fact. Only DIRECT/INHERITED/VERIFIED_DERIVED may be materialized."
  },
  "query_traversal": {
    "CHAPTER_VIEW": {
      "max_depth": 3,
      "allow_reverse": true,
      "relations": ["BELONGS_TO_CHAPTER", "PART_OF_ISLAND", "OCCURS_IN_CHAPTER", "INVOLVES", "CENTERS_ON"]
    },
    "ENTITY_VIEW": {
      "max_depth": 2,
      "allow_reverse": true,
      "relations": ["MEMBER_OF", "INVOLVES", "CENTERS_ON", "PART_OF_ISLAND", "OCCURS_IN_CHAPTER", "OCCURS_IN_REALITY"]
    },
    "TIMELINE_VIEW": {
      "max_depth": 8,
      "allow_reverse": true,
      "relations": ["PRECEDES", "SUCCESSOR_OF", "OCCURS_IN_TIMELINE", "OCCURS_IN_CHAPTER", "INVOLVES", "CENTERS_ON"]
    }
  },
  "relation_semantics": {
    "MEMBER_OF": {"direction":"FORWARD_ONLY_FOR_FACTS","reverse_query":true,"note":"Character membership may derive organization for that character; organization never materializes all members onto an event."},
    "OPPOSES": {"direction":"STORED_DIRECTIONAL","reverse_query":true,"note":"Opposition is query context only unless directly stated for the event."},
    "PART_OF_ISLAND": {"direction":"FORWARD_ONLY_FOR_FACTS","reverse_query":true},
    "BELONGS_TO_CHAPTER": {"direction":"FORWARD_ONLY_FOR_FACTS","reverse_query":true},
    "OCCURS_IN_CHAPTER": {"direction":"FORWARD_ONLY_FOR_FACTS","reverse_query":true},
    "OCCURS_IN_REALITY": {"direction":"FORWARD_ONLY_FOR_FACTS","reverse_query":true},
    "OCCURS_IN_TIMELINE": {"direction":"FORWARD_ONLY_FOR_FACTS","reverse_query":true},
    "INVOLVES": {"direction":"QUERY_CONTEXT","reverse_query":true},
    "CENTERS_ON": {"direction":"QUERY_CONTEXT","reverse_query":true},
    "PRECEDES": {"direction":"TIMELINE_ONLY","reverse_query":true},
    "SUCCESSOR_OF": {"direction":"TIMELINE_ONLY","reverse_query":true},
    "LOCATED_AT": {"direction":"FORWARD_ONLY_FOR_FACTS","reverse_query":true}
  },
  "forbidden_inference": [
    "ORGANIZATION_TO_ALL_MEMBERS_AS_EVENT_FACT",
    "CHAPTER_TO_ALL_CHARACTERS_AS_EVENT_FACT",
    "ISLAND_TO_ALL_POIS_AS_EVENT_FACT",
    "POI_TO_CHARACTER_WITHOUT_EXPLICIT_RELATION",
    "COSMETIC_APPEARANCE_TO_MAIN_STORY_CANON",
    "COLLAB_UNIVERSE_TO_MAIN_TIMELINE",
    "BOSS_ROLE_TO_PERMANENT_CHARACTER_TYPE",
    "NPC_ROLE_TO_FACTION_MEMBERSHIP",
    "SAME_EVENT_TO_FRIENDSHIP_OR_ALLIANCE",
    "SAME_ISLAND_TO_SAME_LORE_ARC",
    "PRECEDES_TO_CAUSATION",
    "ALIAS_TO_CANON_FACT",
    "LEAK_TO_LORE_ENTITY_OR_RELATION"
  ],
  "role_policy": {
    "npc_boss_are_temporal": true,
    "required_scope": true,
    "allowed_scope_keys": ["chapter_id", "season_id", "historical_event_id", "poi_id", "valid_from", "valid_to"],
    "materialize_only_if_current_event_scope_matches": true,
    "no_role_reverse_inference": "A BOSS/NPC role never proves faction, organization or historical-event participation."
  },
  "canon_policy": {
    "MAIN_STORY": "Eligible for CANON_ONLY.",
    "COLLAB_CANON": "Included only when explicitly canonical to the queried context; not automatically merged with main story.",
