  "causal_identity": {
    "problem_solved": "A pure before/after fingerprint would incorrectly suppress a legitimate repeated transition such as SOLD_OUT -> AVAILABLE -> SOLD_OUT. V2 chains each occurrence to the previous accepted change for the same subject/scope.",
    "subject_scope_key": "sub_<sha256(domain|subject_key|scope_key)>",
    "subject_revision": "Monotonic integer per subject_scope_key. Revision increments only for an accepted material semantic transition.",
    "causal_parent_change_id": "Previous accepted change_id for the same subject_scope_key, or null for the first post-bootstrap change.",
    "state_fingerprint": "SHA256 canonical JSON of the material canonical state after the change.",
    "transition_fingerprint": "SHA256 canonical JSON of change_type + material_before + material_after + material_evidence_state.",
    "change_id": "chg_<first-24-hex-of-sha256(domain|subject_key|scope_key|subject_revision|causal_parent_change_id|transition_fingerprint)>>",
    "replay_rule": "Reprocessing the same transition against the same causal parent must reproduce the same revision/change_id and therefore no-op.",
    "real_recurrence_rule": "If the same before/after transition genuinely recurs later, its causal parent/revision differs, so it receives a distinct change_id and may notify once again."
  },
  "semantic_normalization": {
    "algorithm": "SHA256_CANONICAL_JSON_V2",
    "rules": ["sort object keys recursively","sort set-like arrays by stable ID/value","preserve ordered arrays only when order has business meaning","normalize equivalent timezone-aware instants to RFC3339 UTC for hashing while retaining source timezone in domain ledgers","normalize URLs by removing non-identity tracking parameters only","distinguish null from UNKNOWN when domain semantics require it","normalize localized titles/aliases out of identity when a stable ID exists"],
    "ignored_by_default": ["updated_at","checked_at","last_verified_at","fetched_at","crawl timestamps","Git blob SHA alone","DTSTAMP","LAST-MODIFIED without business change","freshness badge expiry","internal score without threshold/action change","derived index ordering","serialization whitespace","JSON key order","ICS folding"]
  },
  "subject_resolution": {
    "SERVICE": "service_event_id + optional component_id",
    "SEASON_PASS": "track_id + optional milestone_id/window_id/ranked_scope",
    "COMPETITIVE": "competition_id + optional phase_id/session_id",
    "COMPETITIVE_DEADLINE": "competition_id + route_id/phase_id + optional session_id + deadline_type",
    "PARTICIPANT_OUTCOME": "participant_id + competition_id + phase_id/route_id",
    "PHYSICAL_EVENT": "physical_event_id + optional public_session_id/venue_space_id",
    "PHYSICAL_ACCESS": "access_profile_id + optional session_id/rule_type",
    "TICKETING": "event_uid + provider_id + optional session_key/category_key",
    "LORE": "claim_id",
    "WATCHLIST": "candidate_id/watch_id",
    "CALENDAR_PROJECTION": "calendar_path + UID"
  },
  "change_acceptance": {
    "fresh_canonical_read": "Before accepting a change, read the latest canonical domain state and the latest subject head/index. A Git SHA difference alone is never enough.",
    "out_of_order_guard": "Older/stale source data cannot move the canonical subject backward unless it is an explicit official correction or genuine later transition.",
    "evidence_upgrade": "Evidence-only changes are material only if authority/confidence/finality/territory changes the supported business meaning or resolves a prior ambiguity.",
    "policy_freeze": "notification_disposition is recorded when the change is accepted. A later notification policy update does not retroactively alert old SILENT_POLICY/BASELINE changes unless explicitly requested as a manual replay."
  },
  "notification_linkage": {
    "outbox_source_of_truth": "fortnite-notification-outbox-france.json",
    "notification_key": "Derived from sorted change_ids + notice_kind + audience_key + channel_key. It intentionally uses change occurrence identity, not only state fingerprints.",
    "coalescing": "Related changes may share one notification intent, but each change remains individually auditable.",
    "planned_boundary": "Future reminders are not notification intents until due. ELIGIBLE_WHEN_DUE remains in the domain reminder ledger/change disposition until its trigger time and conditions are revalidated.",
    "payload_freeze": "Payload wording/version never changes notification identity after reservation."
  },
  "repository_write_idempotency": {
    "ledger_write_key": "wrt_<sha256(target_path|logical_subject|post_write_state_fingerprint)>",
    "calendar_write_key": "cal_<sha256(calendar_path|uid|projected_business_fingerprint)>",
    "cas_rule": "Use fresh blob SHA for every write. On conflict, discard stale mutation, re-fetch and recompute. Never retry a stale full-file payload.",
    "unknown_commit_state": "Fresh-fetch target and compare desired semantic fingerprint. If already present, record recovery and skip duplicate commit.",
    "sequence_rule": "ICS SEQUENCE changes only when projected business state changes, never for headers, folding, DTSTAMP refresh or change-index maintenance."
  },
  "audit_and_reconciliation": {
    "append_only_changes": true,
    "subject_heads": "Derived in fortnite-change-index-france.json; rebuild from changes if divergent.",
    "orphan_change": "A change whose domain target no longer resolves is retained for audit and flagged for reconciliation, not deleted.",
    "outbox_reconciliation": "Every outbox intent must reference existing change_ids. Every consumed key must be derivable from outbox delivery events.",
    "calendar_reconciliation": "A CALENDAR_PROJECTION change may reference the source domain change_ids that caused it to prevent duplicate user alerts for the same underlying fact."
  },
  "retention": {
    "changes": "Append-only in the active ledger until archive policy is introduced.",
    "notification_keys": "Permanent dedupe tombstones live in the outbox or future archive and must be queryable before reservation.",
    "archives": "Future archives must preserve change_id, subject revision chain, consumed notification keys and hash/checkpoint metadata.",
    "no_time_based_forgetting": "Never allow a notification duplicate merely because an old receipt/change aged out."
  },
