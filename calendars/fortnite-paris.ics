TRIGGER;VALUE=DATE-TIME:20260822T090000Z
ACTION:DISPLAY
DESCRIPTION:🏆 Finale Reload Elite Series EWC dans 1 h — départ à 12h
 00 à Paris
END:VALARM
END:VEVENT
