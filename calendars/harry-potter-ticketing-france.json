    "scarcity_evidence": {
      "EXPLICIT_TEXT": "La source directe dit explicitement dernières places, presque complet ou complet.",
      "OFFICIAL_SESSION_DISABLED": "La séance exacte est explicitement indisponible/épuisée sur la billetterie officielle.",
      "CATEGORY_SOLD_OUT": "Une catégorie précise est épuisée mais pas nécessairement la séance entière.",
      "WAITLIST_OFFERED": "Une liste d'attente officielle est proposée.",
      "SEATMAP_STRONG_SIGNAL": "Signal de plan de salle officiel suffisamment robuste, à utiliser avec prudence et jamais seul pour NEARLY_SOLD_OUT sauf seuil explicitement fiable.",
      "UNKNOWN": "Pas de preuve de rareté ; ne pas inférer."
    },
    "confidence": {
      "HIGH": "Source A directe + état explicite pour la séance/catégorie exacte.",
      "MEDIUM": "Source officielle/partenaire mais granularité imparfaite.",
      "LOW": "Signal utile mais insuffisant pour une transition forte ; aucune alerte de rareté."
    },
    "global_vs_session": "L'état global d'un run est dérivé seulement des séances connues : une séance SOLD_OUT ne rend pas le run SOLD_OUT si une autre séance reste AVAILABLE/ON_SALE.",
    "category_rule": "VIP/Premium/Catégorie 1 épuisée ne signifie jamais événement complet. Conserver category_states séparément quand utile.",
    "new_session_rule": "Même production + ville + lieu + run : nouvelle séance => même UID principal, SESSION-* enrichi, SEQUENCE+1 et transition NEW_SESSION_ADDED.",
    "extension_rule": "Même production + ville + lieu prolongée : même UID principal, DTEND étendu, historique conservé, RUN_EXTENDED. Nouvelle ville/lieu => nouvel UID logique.",
    "reopen_rule": "SOLD_OUT/CLOSED -> AVAILABLE/ON_SALE = BACK_ON_SALE seulement avec preuve directe de places remises en vente, jauge libérée ou nouvelle séance.",
    "last_chance_rule": "LAST_CHANCE exige soit une annonce directe, soit une fin de run certaine proche ; dans ce deuxième cas parler de fin prochaine, jamais de rareté des billets.",
    "price_rule": "Suivre structure de prix/min/max/catégories si publiée directement. Une variation liée à une catégorie qui disparaît n'est pas automatiquement une hausse générale.",
    "write_noise": "Aucun commit pour recheck identique. Écrire uniquement transition matérielle, séance/catégorie ajoutée ou retirée, prolongation, changement structurel de prix/lien/provider ou correction métier.",
    "notification_dedupe": "event_uid + transition_type + session_key + category_key + new_status",
    "event_end": "EVENT_ENDED est une maintenance silencieuse sauf anomalie ; ne jamais notifier la simple fin normale.",
    "check_strategy": {
      "HOT": "événement <=14 jours, SOLD_OUT/WAITLIST, nouvelle vente attendue, Paris/IDF critique : vérifier à chaque exécution horaire si utile",
      "WARM": "15 à 60 jours : vérifier au plus toutes les 6 heures sauf signal récent",
      "COLD": ">60 jours : vérifier au plus quotidiennement sauf annonce/signal entrant",
      "LONG_RUN": "run long comme Potted Potter : surveiller quotidiennement globalement, puis augmenter autour des dernières semaines et des séances spéciales"
    }
