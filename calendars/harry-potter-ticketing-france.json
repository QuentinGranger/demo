  "policy": {
    "canonical_key": "event_uid + ticket_provider/source_id + session_key quand une séance doit être distinguée",
    "statuses": [
      "NOT_ANNOUNCED",
      "ANNOUNCED",
      "ON_SALE",
      "AVAILABLE",
      "LOW_AVAILABILITY",
      "NEARLY_SOLD_OUT",
      "SOLD_OUT",
      "WAITLIST",
      "CLOSED",
      "ENDED",
      "CANCELLED"
    ],
    "material_transitions": [
      "SALE_OPENED",
      "LOW_AVAILABILITY",
      "NEARLY_SOLD_OUT",
      "SOLD_OUT",
      "BACK_ON_SALE",
      "NEW_SESSION_ADDED",
      "RUN_EXTENDED",
      "LAST_CHANCE",
      "SALE_CLOSED",
      "EVENT_ENDED",
      "CANCELLED"
    ],
    "evidence": {
      "A": "page billetterie/salle/organisateur directement responsable indiquant explicitement l'état",
      "B": "billetterie partenaire officielle ou salle partenaire directement liée à l'événement",
      "C": "agrégateur/revendeur de billets identifiable, à confirmer si possible",
      "D": "signal de découverte uniquement ; aucune transition forte seule"
    },
    "no_inference": "Ne déduis jamais presque complet/complet à partir d'un plan de salle partiel, d'un message marketing vague ou d'une absence temporaire de sièges si la source ne l'établit pas suffisamment.",
    "session_rule": "Pour un run multi-séances, conserve un état global et des états sessionnels seulement lorsqu'une séance a une disponibilité significativement différente ou devient complète/ajoutée.",
    "extension_rule": "Une prolongation modifie le même VEVENT principal lorsque c'est la même production + ville + lieu ; étendre DTEND, SEQUENCE+1, conserver original/history et créer transition RUN_EXTENDED. Une nouvelle ville reste un VEVENT distinct.",
    "new_session_rule": "Une nouvelle séance dans le même run enrichit le même UID et SESSION-* ; pas de nouveau VEVENT sauf si l'action de billetterie datée mérite une fiche TICKET_ONSALE séparée.",
    "closing_rule": "CLOSED signifie vente fermée avant/au début de l'événement ; ENDED signifie événement terminé. SOLD_OUT n'est pas synonyme de CLOSED.",
    "reopen_rule": "SOLD_OUT/CLOSED -> AVAILABLE/ON_SALE devient BACK_ON_SALE uniquement avec preuve directe ; conserve l'historique.",
    "last_chance_rule": "LAST_CHANCE seulement si source directe annonce dernières places/dernière séance/fin de vente proche, ou si la date de fin est connue et qu'une règle de rappel de fin s'applique ; ne jamais inventer une rareté.",
    "write_noise": "Aucun commit pour simple recheck identique. Écrire seulement sur transition matérielle, nouvelle séance, prolongation, changement de lien/prix structurel ou correction utile.",
    "notification": "Notifier une seule fois par transition logique importante ; SALE_OPENED, NEARLY_SOLD_OUT, SOLD_OUT, BACK_ON_SALE, NEW_SESSION_ADDED, RUN_EXTENDED, LAST_CHANCE, CANCELLED. LOW_AVAILABILITY n'est notifiée que pour un événement prioritaire/Paris ou très demandé."
  },
