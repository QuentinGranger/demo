{
  "name": "Pokemon Geek Box Event Intelligence",
  "version": "2.0",
  "purpose": "Adapter intelligemment les box Pokémon mensuelles aux saisons, événements officiels, sorties et opportunités collector.",
  "event_priority": {
    "official_pokemon_events": 5,
    "pokemon_center_releases": 5,
    "major_anniversaries": 5,
    "seasonal_events": 4,
    "community_events": 3
  },
  "event_rules": {
    "check_events_before_theme_selection": true,
    "adapt_products_to_event": true,
    "avoid_repeating_same_event_theme": true,
    "create_premium_boxes_for_major_events": true,
    "use_collection_history_to_adjust": true
  },
  "recurring_events": {
    "january": {
      "theme_pool": ["nouvelle annee pokemon", "retro pokemon", "bonnes resolutions collection"],
      "preferred_items": ["objet decoration", "piece nostalgique", "organisation collection"]
    },
    "february_valentine": {
      "theme": "Saint-Valentin Pokémon",
      "pokemon_pool": ["Evoli", "Pikachu", "Poussifeu", "Togepi"],
      "ideas": ["duo pokemon", "peluches mignonnes", "objets affectifs"]
    },
    "february_27": {
      "theme": "Pokemon Day",
      "priority": "premium",
      "ideas": ["piece anniversaire", "collector", "nostalgie generations", "objet historique"]
    },
    "spring": {
      "theme": "Printemps Pokémon",
      "types": ["Plante", "Fee", "Insecte"],
      "ideas": ["nature", "jardin", "decoration lumineuse"]
    },
    "summer": {
      "theme": "Vacances Pokémon",
      "types": ["Eau", "Vol"],
      "ideas": ["plage", "voyage", "lifestyle"]
    },
    "september": {
      "theme": "Rentree Pokemon",
      "ideas": ["livres", "papeterie", "academie pokemon"]
    },
    "october": {
      "theme": "Halloween Pokémon",
      "types": ["Spectre", "Tenebres"],
      "pokemon_pool": ["Mimiqui", "Ectoplasma", "Noctali"],
      "ideas": ["decoration sombre", "ambiance vitrine", "objets mysteres"]
    },
    "november": {
      "theme": "Japon Pokémon",
      "priority": "japanese_exclusives",
      "ideas": ["Pokemon Center Japon", "Pokemon Fit", "import japonais"]
    },
    "december": {
      "theme": "Noel Pokémon",
      "ideas": ["Pikachu hiver", "peluches festives", "cadeau souvenir"]
    }
  },
  "special_events": {
    "pokemon_center_release": {
      "action": "create_release_box"
    },
    "new_game_release": {
      "action": "adapt_box_to_new_region_or_pokemon"
    },
    "anime_release": {
      "action": "create_character_or_region_box"
    },
    "movie_release": {
      "action": "create_special_memory_box"
    },
    "collaboration": {
      "action": "prioritize_unique_products"
    }
  },
  "generation_logic": {
    "season_weight": true,
    "event_weight": true,
    "history_weight": true,
    "collection_goal_weight": true,
    "product_availability_weight": true
  },
  "future_analysis": {
    "track_used_events": true,
    "suggest_new_themes": true,
    "detect_overused_seasons": true,
    "prepare_yearly_calendar": true
  }
}
