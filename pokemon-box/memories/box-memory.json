  "analysis": {
    "create_timeline": true,
    "compare_years": true,
    "find_favorite_themes": true,
    "detect_emotional_patterns": true,
    "generate_collection_story": true,
    "identify_most_important_items": true
  },
  "example": {
    "2026-09": {
      "theme": "Evoli Lifestyle",
