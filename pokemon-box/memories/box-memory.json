    "save_first_impression": true,
    "save_unboxing_experience": true,
    "save_collection_evolution": true
  },
  "box_entry_template": {
    "date": "YYYY-MM",
    "theme": "",
    "season": "",
    "main_pokemon": [],
    "products": [],
