    "photo": {
      "before_display": "",
      "after_display": "",
      "vitrine": "",
      "unboxing": ""
    },
    "story": {
      "why_chosen": "Pourquoi cette box a été choisie",
      "personal_memory": "Souvenir associé à cette box",
